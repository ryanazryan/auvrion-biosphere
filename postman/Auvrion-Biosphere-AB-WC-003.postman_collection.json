    {
      "name": "02 — Applicant Request Access",
      "description": "Run submit (public) then verify email through Mailpit at http://localhost:8025. The draft requests are NOT authoritative without checking the local route contract.",
      "item": [
        {
          "name": "Request Access — Submit Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicantName\": \"Demo Reviewer WC003\",\n  \"email\": \"{{applicantEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/access-applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "access-applications"]
            },
            "description": "Confirmed route path from local `src/app/api/access-applications/route.ts`; expected POST from prior working demo, but validate request/response schema against local handler before relying on exact assertion. Public API; no role/status fields accepted."
          },
          "response": []
        },
        {
          "name": "DRAFT — Request Email Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/access-applications/email-verification/request",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "access-applications",
                "email-verification",
                "request"
              ]
            },
            "description": "DRAFT CONTRACT — path confirmed from local files. Method, body, CSRF, response shape MUST be checked in src/app/api/access-applications/email-verification/request/route.ts before executing. Do not mark as verified.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{applicantEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "DRAFT — Confirm Email Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/access-applications/email-verification/confirm",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "access-applications",
                "email-verification",
                "confirm"
              ]
            },
            "description": "DRAFT CONTRACT — path confirmed; method/body token field not verified from local handler. Token is single-use and sensitive; store temporary token in local-only Postman variables, never commit/export it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{emailVerificationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
