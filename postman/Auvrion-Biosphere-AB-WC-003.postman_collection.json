    {
      "name": "03 — Admin Decision (requires approved active admin + TOTP)",
      "description": "Uses session cookies from Better Auth sign-in + completed TOTP challenge. Do not send manually forged cookies. Local-only route is gated by NODE_ENV=development and ENABLE_LOCAL_ACCESS_REQUESTS=YES. Approve does not activate user.",
      "item": [
        {
          "name": "Approve — Valid Email Verified Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/access-applications/{{applicationId}}/decision",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "admin",
                "access-applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "description": "Success depends on admin session MFA assurance and reviewable application. Expected JSON status approved; rerunning same application should return 409; use fresh applicationId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"reason\": \"Reviewed email ownership and application.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"No server failure\", function () { pm.expect(pm.response.code).to.be.below(500); });",
                  "if (pm.response.code === 200) { pm.test(\"Approved\", function () { pm.expect(pm.response.json().status).to.eql(\"approved\"); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject — Separate Valid Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/access-applications/{{applicationId}}/decision",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "admin",
                "access-applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "description": "Use a DIFFERENT email_verified applicationId from approval; never reject an already approved application.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"rejected\",\n  \"reason\": \"Incomplete applicant information for development review.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Negative — Rejection Without Reason (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/access-applications/{{applicationId}}/decision",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "admin",
                "access-applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "description": "Expected 400 REJECTION_REASON_REQUIRED, regardless of valid admin session. Does not mutate database.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"rejected\",\n  \"reason\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative — Unauthenticated Decision",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/access-applications/{{applicationId}}/decision",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "admin",
                "access-applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "description": "Disable cookies for this request; expected 401/403 after app/environment validation and when origin correct. Use dedicated Postman session to avoid cookie leakage.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"reason\": \"Unauthenticated negative test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthorized request rejected\", function () { pm.expect([401,403]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative — Wrong Origin (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://invalid-origin.test"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/access-applications/{{applicationId}}/decision",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "admin",
                "access-applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "description": "Explicit invalid Origin should be rejected before checking session. Do not include real secrets.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"reason\": \"Wrong-origin negative test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
