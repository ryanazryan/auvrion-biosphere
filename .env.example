# Optional for the homepage and /api/health; required only for database access.
# Copy to ignored .env.local and supply credentials for a dedicated LOCAL database.
# Format: postgresql://<user>:<URL-encoded-password>@127.0.0.1:<port>/<database>
# G1B accepts loopback hosts only and no URL query parameters.
# Never use production credentials, a NEXT_PUBLIC_ prefix, or commit .env.local.
DATABASE_URL=