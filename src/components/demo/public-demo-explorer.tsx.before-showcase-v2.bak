"use client";

import type { Map as MapInstance } from "maplibre-gl";
import Link from "next/link";
import { useEffect, useRef, useState } from "react";
import "maplibre-gl/dist/maplibre-gl.css";

type Region = "Kalimantan" | "Sumatra" | "Jawa" | "Sulawesi" | "Papua";
const regions: Record<Region, [number, number, number]> = {
  Kalimantan: [114.5, -1.8, 5],
  Sumatra: [101.3, -0.8, 4.5],
  Jawa: [110.4, -7.3, 6],
  Sulawesi: [121, -2.1, 5],
  Papua: [137.2, -3.9, 4.5],
};

export function PublicDemoExplorer() {
  const container = useRef<HTMLDivElement>(null);
  const map = useRef<MapInstance | null>(null);
  const [region, setRegion] = useState<Region>("Kalimantan");
  const [mapFailed, setMapFailed] = useState(false);

  useEffect(() => {
    if (!container.current) return;
    let disposed = false;
    let active: MapInstance | null = null;
    void import("maplibre-gl")
      .then((maplibregl) => {
        if (disposed || !container.current) return;
        maplibregl.setWorkerUrl("/vendor/maplibre/maplibre-gl-worker.mjs");
        const instance = new maplibregl.Map({
          container: container.current,
          style: "https://tiles.openfreemap.org/styles/liberty",
          center: [114.5, -1.8],
          zoom: 5,
          attributionControl: {
            compact: true,
          },
        });
        instance.addControl(new maplibregl.NavigationControl(), "top-right");
        instance.on("error", () => {
          if (!disposed) setMapFailed(true);
        });
        active = instance;
        map.current = instance;
      })
      .catch(() => {
        if (!disposed) setMapFailed(true);
      });
    return () => {
      disposed = true;
      active?.remove();
      if (map.current === active) map.current = null;
    };
  }, []);

  function navigate(next: Region) {
    setRegion(next);
    const [longitude, latitude, zoom] = regions[next];
    map.current?.flyTo({
      center: [longitude, latitude],
      zoom,
      essential: true,
    });
  }

  return (
    <main className="min-h-screen bg-bg px-4 py-8 text-fg sm:px-8">
      <div className="mx-auto max-w-6xl">
        <nav className="flex flex-wrap items-center justify-between gap-4">
          <Link href="/login" className="text-sm font-semibold text-brand">
            Auvrion Biosphere
          </Link>
          <div className="flex gap-4 text-sm">
            <Link
              href="/request-access"
              className="font-medium text-brand hover:underline"
            >
              Ajukan akses
            </Link>
            <Link href="/login" className="hover:underline">
              Masuk
            </Link>
          </div>
        </nav>
        <header className="mt-10 max-w-3xl">
          <p className="text-xs font-semibold uppercase tracking-widest text-brand">
            Demo publik · Read-only
          </p>
          <h1 className="mt-3 text-3xl font-semibold sm:text-4xl">
            Eksplorasi Auvrion Biosphere
          </h1>
          <p className="mt-4 text-sm leading-7 text-muted">
            Jelajahi peta dasar Indonesia dan pahami alur LISTEN, PREVENT, serta
            verifikasi manusia. Halaman ini tidak berisi akun, rekaman privat,
            kasus internal, atau indikator kejadian langsung.
          </p>
        </header>
        <section
          aria-label="Peta interaktif demonstrasi"
          className="mt-8 overflow-hidden rounded-xl border border-line bg-surface"
        >
          <div className="flex flex-wrap items-center justify-between gap-3 border-b border-line p-4">
            <h2 className="text-base font-semibold">
              WebGIS · Peta dasar interaktif
            </h2>
            <label className="flex items-center gap-2 text-sm">
              <span className="text-muted">Wilayah</span>
              <select
                aria-label="Pilih wilayah peta"
                value={region}
                onChange={(event) => navigate(event.target.value as Region)}
                className="rounded-md border border-line bg-bg px-3 py-2 text-fg"
              >
                {Object.keys(regions).map((value) => (
                  <option key={value} value={value}>
                    {value}
                  </option>
                ))}
              </select>
            </label>
          </div>
          <div
            ref={container}
            className="h-[420px] w-full bg-brand-50"
            role="img"
            aria-label="Peta navigasi wilayah Indonesia tanpa titik insiden"
          />
          {mapFailed && (
            <p role="status" className="p-3 text-sm text-muted">
              Peta dasar tidak dapat dimuat saat ini. Koneksi ke penyedia tiles
              mungkin terhalang.
            </p>
          )}
          <p className="border-t border-line p-4 text-xs leading-5 text-muted">
            Data peta: OpenFreeMap / OpenStreetMap. Tidak ada titik hotspot,
            posisi Ranger, atau data observasi yang dipublikasikan di demo ini.
            Data operasional memerlukan akun dan otorisasi.
          </p>
        </section>
        <section
          aria-label="Modul sistem"
          className="mt-8 grid gap-4 md:grid-cols-3"
        >
          <article className="rounded-xl border border-line bg-surface p-5">
            <h2 className="text-lg font-semibold">LISTEN</h2>
            <p className="mt-2 text-sm leading-6 text-muted">
              ESP32 mengumpulkan rekaman akustik. Model bioakustik dapat
              membantu menyiapkan analisis; manusia tetap meninjau hasil dan
              bukti.
            </p>
            <p className="mt-3 text-xs text-muted">
              Alur konseptual, bukan hasil analisis langsung.
            </p>
          </article>
          <article className="rounded-xl border border-line bg-surface p-5">
            <h2 className="text-lg font-semibold">PREVENT</h2>
            <p className="mt-2 text-sm leading-6 text-muted">
              Referensi anomali termal satelit, kondisi lingkungan, dan laporan
              lapangan mendukung penilaian risiko kebakaran.
            </p>
            <p className="mt-3 text-xs text-muted">
              Anomali termal bukan bukti kebakaran terkonfirmasi.
            </p>
          </article>
          <article className="rounded-xl border border-line bg-surface p-5">
            <h2 className="text-lg font-semibold">Human-in-the-loop</h2>
            <p className="mt-2 text-sm leading-6 text-muted">
              Operator mengirim observasi, Supervisor meninjau dan menugaskan,
              Ranger memeriksa di lapangan, lalu Supervisor menutup kasus.
            </p>
            <p className="mt-3 text-xs text-muted">
              Aksi operasional tidak tersedia di demo publik.
            </p>
          </article>
        </section>
        <div className="mt-8 flex flex-wrap items-center gap-3 pb-10">
          <Link
            href="/request-access"
            className="rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white hover:bg-brand-hover"
          >
            Ajukan akses operasional
          </Link>
          <Link
            href="/login"
            className="rounded-lg border border-line px-5 py-3 text-sm font-medium hover:bg-surface"
          >
            Login
          </Link>
        </div>
      </div>
    </main>
  );
}
