
# ==========================================
# AUVRION BIOSPHERE — .gitignore
# Next.js Full-Stack Modular Monolith
# ==========================================

# Dependencies
node_modules/

# Next.js generated files
.next/
out/
next-env.d.ts

# TypeScript build cache
*.tsbuildinfo

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local npm cache
.npm/

# Test results and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Build and tooling artifacts
dist/
build/
.turbo/
.cache/

# Deployment artifacts
.vercel/

# Local certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Local credentials and private notes
/auvrion-biosphere.txt
/githubnoreplay.txt
# Generated MapLibre v6 Web Worker assets, prepared before dev/build
/public/vendor/maplibre/

# WC-014 local browser QA secrets and output
e2e/.auth/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# AB-WC-015 - ESP32 LISTEN
/firmware/listen-esp32/.pio/
/firmware/listen-esp32/include/listen_secrets.h
/firmware/listen-esp32/*.wav
/firmware/listen-esp32/main-wav-backup.txt

# Python Perch virtual environment
/.venv-perch/

# Local backup artifacts
*.mfa-before
*.wc024-identity-backup

# AB-WC-015 - ESP32 LISTEN
/firmware/listen-esp32/.pio/
/firmware/listen-esp32/include/listen_secrets.h
/firmware/listen-esp32/*.wav
/firmware/listen-esp32/main-wav-backup.txt

# Python Perch virtual environment
/.venv-perch/

# Local backup artifacts
*.mfa-before
*.wc024-identity-backup