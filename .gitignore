
# ==========================================
# AUVRION BIOSPHERE — .gitignore
# Next.js Full-Stack Modular Monolith
# ==========================================

# Dependencies
node_modules/

# Next.js generated files
.next/
out/
next-env.d.ts

# TypeScript build cache
*.tsbuildinfo

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local npm cache
.npm/

# Test results and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Build and tooling artifacts
dist/
build/
.turbo/
.cache/

# Deployment artifacts
.vercel/

# Local certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
